MOVIE_PROVIDER=onedrive
# For the local Movie Room front end, use Jellyfin as the backend instead:
# MOVIE_PROVIDER=jellyfin
# JELLYFIN_URL=http://127.0.0.1:8096
# JELLYFIN_API_KEY=enter-a-Jellyfin-server-api-key-locally
# Optional: the Jellyfin library item id to limit discovery to one library.
# JELLYFIN_LIBRARY_ID=
APP_ORIGIN=https://your-app.vercel.app
TRUST_PROXY=true
MOVIE_PASSWORD=replace-with-shared-password
# Must be a randomly generated secret of at least 32 UTF-8 bytes.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_MS=43200000
# Cast links are opaque, movie-scoped, and expire no later than the signed-in session.
CAST_PLAYBACK_TTL_MS=21600000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

ONEDRIVE_CLIENT_ID=replace-with-microsoft-app-client-id
ONEDRIVE_CLIENT_SECRET=replace-with-microsoft-app-client-secret-if-required
ONEDRIVE_PUBLIC_CLIENT=false
ONEDRIVE_REDIRECT_URI=https://your-app.vercel.app/
ONEDRIVE_REFRESH_TOKEN=replace-with-owner-refresh-token
ONEDRIVE_DRIVE_ID=replace-with-drive-id
ONEDRIVE_ROOT_ITEM_ID=replace-with-folder-item-id

# Required on Vercel so sessions, throttling, and rotated OneDrive tokens survive across function instances.
# The Vercel Marketplace Upstash integration supplies these automatically.
KV_REST_API_URL=replace-with-vercel-upstash-rest-url
KV_REST_API_TOKEN=replace-with-vercel-upstash-rest-token
